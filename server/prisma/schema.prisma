generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model WebhookEvent {
  id             String  @id @default(uuid())
  source         String
  idempotencyKey String
  eventType      String
  payload        Json
  status         String
  errorReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, idempotencyKey])
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  razorpayPaymentId String   @unique

  userId            String?  @db.Uuid
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  connectionId      String?  @db.Uuid
  connection        ConnectorCredential? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  amount            BigInt
  currency          String
  status            String
  method            String
  orderId           String?
  invoiceId         String?
  bank              String?
  vpa               String?
  email             String?
  contact           String?
  errorCode         String?
  errorDescription  String?
  errorSource       String?
  errorStep         String?
  errorReason       String?
  acquirerData      Json?
  notes             Json?
  paymentCreatedAt  DateTime @db.Timestamptz(3)
  customerId        String?
  captured          Boolean?
  description       String?
  international     Boolean?
  tokenId           String?
  offerId           String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  correlations  PaymentFailureCorrelation[]
  recoveryCases RecoveryCase[]

  @@index([userId])
  @@index([connectionId])
  @@index([razorpayPaymentId])
  @@index([customerId])
  @@index([contact, status])
  @@index([method])
  @@index([errorSource])
  @@index([errorReason])
}

enum PaymentDowntimeStatus {
  SCHEDULED
  STARTED
  UPDATED
  RESOLVED
}

model PaymentDowntime {
  id               String                @id @default(uuid()) @db.Uuid
  razorpayId       String                @unique
  entity           String                @default("payment.downtime")

  userId           String?               @db.Uuid
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  connectionId     String?               @db.Uuid
  connection       ConnectorCredential?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  method           String
  begin            DateTime              @db.Timestamptz(3)
  end              DateTime?             @db.Timestamptz(3)
  status           PaymentDowntimeStatus
  scheduled        Boolean
  severity         String?
  instrument       Json?
  instrumentSchema Json?
  createdAt        DateTime              @db.Timestamptz(3)
  updatedAt        DateTime              @db.Timestamptz(3)
  rawPayload       Json?

  correlations PaymentFailureCorrelation[]

  @@index([userId])
  @@index([connectionId])
  @@index([method])
  @@index([status])
  @@index([begin])
  @@index([end])
  @@index([method, status])
}

enum PaymentFailureCorrelationStatus {
  CANDIDATE
  MATCHED
  REJECTED
  SUPERSEDED
}

enum PaymentFailureCorrelationConfidence {
  LOW
  MEDIUM
  HIGH
}

enum PaymentFailureCorrelationMatchType {
  TIME_OVERLAP
  METHOD_MATCH
  BANK_MATCH
  ISSUER_MATCH
  NETWORK_MATCH
  PSP_MATCH
  VPA_MATCH
  MULTI_SIGNAL
}

model PaymentFailureCorrelation {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  downtimeId String          @db.Uuid
  downtime   PaymentDowntime @relation(fields: [downtimeId], references: [id], onDelete: Cascade)

  status     PaymentFailureCorrelationStatus     @default(CANDIDATE)
  confidence PaymentFailureCorrelationConfidence

  explanation    String?  @db.Text
  score          Decimal? @db.Decimal(5, 4)
  matchedSignals Json?

  paymentContext  Json?
  downtimeContext Json?

  correlatedAt DateTime @default(now()) @db.Timestamptz(3)
  evaluatedAt  DateTime @default(now()) @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  recoveryCases RecoveryCase[]

  @@unique([paymentId, downtimeId])
  @@index([paymentId])
  @@index([downtimeId])
  @@index([status])
  @@index([confidence])
  @@index([correlatedAt])
}

enum RecoveryCaseStatus {
  OPEN
  ANALYZING
  WAITING
  ACTION_REQUIRED
  ESCALATED
  RECOVERED
  STOPPED
  FAILED
  EXPIRED
}

enum RecoveryCaseType {
  PAYMENT_FAILURE
  CART_ABANDONMENT
  SUBSCRIPTION_DUE
}

model RecoveryCase {
  id        String  @id @default(uuid()) @db.Uuid
  
  type      RecoveryCaseType @default(PAYMENT_FAILURE)

  subjectType String?
  subjectId   String?

  activeSkillId      String?
  activeSkillVersion Int?
  
  // Legacy fields
  paymentId String?  @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  cartId    String?  @db.Uuid

  correlationId String?                    @db.Uuid
  correlation   PaymentFailureCorrelation? @relation(fields: [correlationId], references: [id], onDelete: SetNull)

  status RecoveryCaseStatus @default(OPEN)

  // Snapshots for context
  contextSnapshot Json?
  strategyApplied String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  actions RecoveryAction[]
  schedules RecoverySchedule[]
  outcome Outcome?
}

enum RecoveryActionType {
  EMAIL
  SMS
  WHATSAPP
  VOICE
  IN_APP
  INTERNAL_SYSTEM_ACTION
}

model RecoveryAction {
  id             String       @id @default(uuid()) @db.Uuid
  recoveryCaseId String       @db.Uuid
  recoveryCase   RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  type           RecoveryActionType
  status         String
  payload        Json?
  idempotencyKey String?      @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Outcome {
  id             String       @id @default(uuid()) @db.Uuid
  recoveryCaseId String       @unique @db.Uuid
  recoveryCase   RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  successful      Boolean
  amountRecovered BigInt?
  notes           String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model AuditEvent {
  id         String  @id @default(uuid()) @db.Uuid
  entityId   String  @db.Uuid
  entityType String
  action     String
  oldValue   Json?
  newValue   Json?
  actor      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
}

model User {
  id            String  @id @default(uuid()) @db.Uuid
  email         String  @unique
  password      String
  emailVerified Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  deviceSessions       DeviceSession[]
  connectorCredentials ConnectorCredential[]
  agents               Agent[]
  payments             Payment[]
  paymentDowntimes     PaymentDowntime[]

  @@index([email])
}

model DeviceSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName String   @default("Unknown Device")
  ipAddress  String?
  expiresAt  DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

enum ConnectorCategory {
  DATA_SOURCE
  COMMUNICATION_SOURCE
}

model ConnectorCredential {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  connectorId String
  category    ConnectorCategory
  name        String

  encryptedData String
  iv            String
  authTag       String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  payments             Payment[]
  paymentDowntimes     PaymentDowntime[]
  agents               AgentConnector[]

  @@unique([userId, connectorId, name])
  @@index([userId])
  @@index([category])
}

enum AgentStatus {
  ACTIVE
  PAUSED
  DISABLED
  ARCHIVED
}

model Agent {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  version     Int         @default(1)
  description String?
  status      AgentStatus @default(ACTIVE)

  purpose String @db.Text

  triggers String[]

  requiredCapabilities String[]

  rules Json

  actions String[]

  stopConditions String[]

  connections AgentConnector[]
  executions  AgentExecution[]

  spec Json

  installedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

enum AgentExecutionStatus {
  QUEUED
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  BLOCKED
  CANCELLED
  TIMED_OUT
}

model AgentExecution {
  id String @id @default(uuid()) @db.Uuid

  agentId String @db.Uuid
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  agentVersion Int

  userId String @db.Uuid

  triggerType      String   // payment.failed, recovery.schedule
  triggerId        String?  @db.Uuid // internal DB ID
  externalTriggerId String? // provider-assigned ID (Razorpay evt_xxx)

  provider String?

  status AgentExecutionStatus @default(QUEUED)

  recoveryCaseId String? @db.Uuid

  inputContext Json?

  decision Json?

  result Json?

  error Json?

  jobId String?

  queuedAt    DateTime  @default(now()) @db.Timestamptz(3)
  startedAt   DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([agentId, triggerType, triggerId])
  @@index([userId, status])
  @@index([agentId, status])
  @@index([triggerType])
  @@index([recoveryCaseId])
  @@index([externalTriggerId])
}

model AgentConnector {
  agentId     String              @db.Uuid
  agent       Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  connectorId String              @db.Uuid
  connector   ConnectorCredential @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  connectedAt DateTime            @default(now()) @db.Timestamptz(3)

  @@id([agentId, connectorId])
  @@index([agentId])
  @@index([connectorId])
}

// Recovery Schedule
enum RecoveryScheduleStatus {
  SCHEDULED
  FIRED
  CANCELLED
  FAILED
}

model RecoverySchedule {
  id                   String                 @id @default(uuid()) @db.Uuid
  recoveryCaseId       String                 @db.Uuid
  recoveryCase         RecoveryCase           @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  executeAt            DateTime               @db.Timestamptz(3)
  reason               String?
  status               RecoveryScheduleStatus @default(SCHEDULED)
  jobId                String?
  createdByExecutionId String?                @db.Uuid
  triggeredExecutionId String?                @unique @db.Uuid

  firedAt     DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([recoveryCaseId, status])
  @@index([executeAt, status])
  @@index([jobId])
}

// Transactional Outbox
enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String           @id @default(uuid()) @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int              @default(0)
  publishedAt   DateTime?        @db.Timestamptz(3)
  lastError     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}
