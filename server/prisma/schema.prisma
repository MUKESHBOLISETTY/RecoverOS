generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model IncomingEvent {
  id             String   @id @default(uuid())
  source         String
  idempotencyKey String
  eventType      String
  payload        Json
  status         String
  errorReason    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([source, idempotencyKey])
}